{
  "name": "piphi-zwave-js-sidecar",
  "version": "0.1.0",
  "description": "Managed Z-Wave JS driver sidecar for PiPhi Network.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx tests/*.test.ts",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "fastify": "^5.3.0",
    "piphi-runtime-kit-node": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
